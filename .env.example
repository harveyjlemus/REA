# Copy this file to .env and fill in the keys you use.
# .env is gitignored. Never commit real keys.
# Nothing here is needed for `make check`: the tests and the demo run offline.
# A variable already set in your environment (or in the cloud environment's
# secrets) always wins over this file.

# --- Google search for founder names and email patterns (lane 6) ---
# https://serper.dev  (2,500 free searches on signup)
SERPER_API_KEY=

# --- Email verification (lane 7) ---
# https://app.millionverifier.com  -> API
MILLIONVERIFIER_API_KEY=

# --- Database lookups (lane 4) ---
# https://app.getleads.io  -> API keys (starts with glb_live_)
GETLEADS_API_KEY=

# --- Optional: what you pay, so the cost report shows dollars ---
# Leave blank and the ledger records credits with an "unknown" dollar cost.
# Million Verifier: price of your credit pack divided by its credits.
MV_USD_PER_CHECK=
# Serper: price of your pack divided by its searches (blank while on free credits).
SERPER_USD_PER_SEARCH=
# GetLeads: 0 on the unlimited plan.
GETLEADS_USD_PER_CREDIT=0

# --- Polite identification when reading company websites ---
# A User-Agent with a contact URL or email you own.
FEF_USER_AGENT=

# --- Advanced (optional) ---
# GETLEADS_BASE_URL=https://app.getleads.io
# FEF_CACHE_DIR=.fef-cache
